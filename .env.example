# Copie para .env e preencha. O .env não vai para o Git.
#
# Sem DJANGO_SECRET_KEY, o desenvolvimento usa uma chave temporária.
# Para gerar um valor:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Configurações do PostgreSQL (ADR 0003)
POSTGRES_DB=sem_barreiras
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
